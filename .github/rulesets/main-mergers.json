{
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "name": "main: admins and maintainers merge",
  "bypass_actors": [
    {
      "actor_type": "RepositoryRole",
      "actor_id": 4,
      "bypass_mode": "pull_request"
    },
    {
      "actor_type": "RepositoryRole",
      "actor_id": 5,
      "bypass_mode": "pull_request"
    },
    {
      "actor_type": "DeployKey",
      "actor_id": null,
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "update"
    }
  ]
}
