{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "report/ui",
    "src/features/migrations/model.ts",
    "src/features/migrations/brief.ts",
    "src/features/migrations/targets.ts",
    "report/prepare-dto-archive.ts"
  ]
}
