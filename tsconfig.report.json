{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "report/ui",
    "report/openapi",
    "src/features/openapi/**/*.ts",
    "src/features/migrations/model.ts",
    "src/features/migrations/format.ts",
    "src/features/migrations/targets.ts",
    "report/prepare-dto-archive.ts"
  ]
}
